<?xml version="1.0" encoding="utf-8"?>
<!-- Read-only library/player palette sample; theme attributes are populated at bind time. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/rd_m5_preview_title"
        android:textColor="?android:attr/textColorPrimary"
        android:textStyle="bold"
        android:textSize="16sp" />
    <TextView
        android:id="@+id/rd_m5_preview_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/rd_m5_preview_help"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginTop="4dp" />
    <LinearLayout
        android:id="@+id/rd_m5_preview_surface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp"
        android:padding="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <View
                android:id="@+id/rd_m5_preview_accent"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/rd_m5_library_sample"
                android:textColor="?android:attr/textColorPrimary" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rd_m5_preview_player"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="10dp"
            android:layout_marginTop="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/rd_m5_player_sample"
                android:textColor="?android:attr/textColorPrimary" />
            <TextView
                android:id="@+id/rd_m5_preview_play"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="▶"
                android:textColor="@android:color/black"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
